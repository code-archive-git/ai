    "from joblib import load # dump 로 저장한 내용을 load 로 읽어들인다.\n",
    "path = '/content/knn_iris.joblib'\n",
    "\n",
    "names = ['Setosa','Virsicolor','Virginica']\n",
    "\n",
    "# 저장된 내용 불러오기\n",
    "class_knn = load(path)\n",
    "\n",
    "sample = [[5,5,3,2],[2,4,3,5]]\n",
    "\n",
    "results = class_knn.predict(sample)\n",
    "\n",
    "for r in results:\n",
    "  print(names[r])"
   ]
  }
